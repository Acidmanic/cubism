<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cubism\Cubism.csproj" />
  </ItemGroup>

  
  <ItemGroup>
    <!-- Drawing 3.x refuses to compile without a Six Labors license. 2.1.7 is the last release that builds without one, and it depends on ImageSharp 3.1.11. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.7" />
  </ItemGroup>
</Project>
